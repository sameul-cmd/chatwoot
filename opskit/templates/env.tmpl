# Chatwoot environment for ${CLIENT_ID}. Generated by opskit (mode 600). Never commit.
SECRET_KEY_BASE=${SECRET_KEY_BASE}
FRONTEND_URL=${FRONTEND_URL}
FORCE_SSL=false
ENABLE_ACCOUNT_SIGNUP=false
RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=${RAILS_MAX_THREADS}
SIDEKIQ_CONCURRENCY=${SIDEKIQ_CONCURRENCY}

POSTGRES_HOST=postgres
POSTGRES_USERNAME=postgres
POSTGRES_DATABASE=chatwoot
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# Lets Chatwoot call the aibot container on the internal network (ADR-012).
SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true

ACTIVE_STORAGE_SERVICE=${STORAGE_SERVICE}
MAILER_SENDER_EMAIL=${SMTP_SENDER}
SMTP_DOMAIN=${SMTP_DOMAIN}
SMTP_ADDRESS=${SMTP_HOST}
SMTP_PORT=${SMTP_PORT}
${SMTP_AUTH_LINES}
SMTP_ENABLE_STARTTLS_AUTO=${SMTP_STARTTLS}
