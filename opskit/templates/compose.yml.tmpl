# Rendered by opskit for client ${CLIENT_ID}. Do not edit on the server: change client.yaml and re-render.
x-chatwoot: &chatwoot
  image: ${CW_IMAGE}:${CW_TAG}
  env_file: .env
  volumes:
    - storage:/app/storage
  restart: always
  environment:
    NODE_ENV: production
    RAILS_ENV: production
    INSTALLATION_ENV: docker

services:
  rails:
    <<: *chatwoot
    depends_on: [postgres, redis]
    entrypoint: docker/entrypoints/rails.sh
    command: ["bundle", "exec", "rails", "s", "-p", "3000", "-b", "0.0.0.0"]
    mem_limit: ${RAILS_MEM}
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/api"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s

  sidekiq:
    <<: *chatwoot
    depends_on: [postgres, redis]
    command: ["bundle", "exec", "sidekiq", "-C", "config/sidekiq.yml"]
    mem_limit: ${SIDEKIQ_MEM}

  postgres:
    image: pgvector/pgvector:pg16
    restart: always
    volumes:
      - postgres:/var/lib/postgresql/data
    env_file: postgres.env
    mem_limit: ${POSTGRES_MEM}
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U postgres -d chatwoot"]
      interval: 10s
      timeout: 5s
      retries: 10

  redis:
    image: redis:alpine
    restart: always
    command: ["sh", "-c", "redis-server --requirepass \"$$REDIS_PASSWORD\""]
    env_file: redis.env
    volumes:
      - redis:/data
    mem_limit: ${REDIS_MEM}
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$REDIS_PASSWORD\" ping | grep -q PONG"]
      interval: 10s
      timeout: 5s
      retries: 10

  aibot:
    image: opskit-aibot:${CLIENT_ID}
    env_file: aibot.env
    restart: always
    volumes:
      - aibot:/data
      - ./bot.yaml:/config/bot.yaml:ro
      - ../kb:/kb:ro
    mem_limit: ${AIBOT_MEM}
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://localhost:8000/health', timeout=3).status == 200 else 1)"]
      interval: 30s
      timeout: 5s
      retries: 5

  caddy:
    image: caddy:2
    restart: always
    ports:
      - "${HTTP_BIND}:80"
      - "${HTTPS_BIND}:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
    depends_on: [rails]
    mem_limit: 128m
${MAILPIT_SERVICE}
volumes:
  storage:
    name: ${CLIENT_ID}_storage
  postgres:
    name: ${CLIENT_ID}_postgres
  redis:
    name: ${CLIENT_ID}_redis
  aibot:
    name: ${CLIENT_ID}_aibot
  caddy_data:
    name: ${CLIENT_ID}_caddy
