#!/usr/bin/env bash
# Rehearse a fork sync (docs/UPSTREAM_SYNC.md) WITHOUT touching the real branch:
#   build "OLD release + our kit" in a throw-away worktree, merge NEW release into it, report conflicts and verify
#   that only our paths differ from NEW afterwards. Everything is deleted at the end.
# Usage: sync-rehearsal OLD_TAG NEW_TAG [--base TAG] [--repo DIR]
#   --base  the release our kit is currently built on (default: the pin in docs/UPSTREAM_CHANGES.md)
# Exit: 0 clean, 1 conflicts or files outside our paths, 2 usage/setup problem.
set -euo pipefail

OLD="" NEW="" BASE="" REPO=""
while [ $# -gt 0 ]; do
  case "$1" in
    --base) BASE="${2:-}"; shift 2 ;;
    --repo) REPO="${2:-}"; shift 2 ;;
    -h | --help) sed -n '2,9p' "$0"; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) if [ -z "$OLD" ]; then OLD="$1"; elif [ -z "$NEW" ]; then NEW="$1"; else echo "too many arguments" >&2; exit 2; fi; shift ;;
  esac
done
if [ -z "$OLD" ] || [ -z "$NEW" ]; then
  echo "usage: sync-rehearsal OLD_TAG NEW_TAG [--base TAG] [--repo DIR]" >&2
  exit 2
fi
for t in "$OLD" "$NEW" "$BASE"; do
  [ -z "$t" ] || [[ "$t" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "invalid tag: $t" >&2; exit 2; }
done
REPO="${REPO:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)}"
git -C "$REPO" rev-parse --git-dir >/dev/null 2>&1 || { echo "not a git repository: $REPO" >&2; exit 2; }
if [ -z "$BASE" ]; then
  BASE="$(sed -n 's/^| Pinned release tag | \(v[0-9.]*\) |$/\1/p' "$REPO/docs/UPSTREAM_CHANGES.md" 2>/dev/null || true)"
fi
[ -n "$BASE" ] || { echo "cannot determine the base release: pass --base TAG" >&2; exit 2; }
for t in "$OLD" "$NEW" "$BASE"; do
  git -C "$REPO" rev-parse -q --verify "refs/tags/${t}^{commit}" >/dev/null || { echo "release ${t} is not in this checkout: git fetch upstream tag ${t} --no-tags" >&2; exit 2; }
done

ALLOWED='^(opskit/|aibot/|docs/|explore/|\.claude/|README-START-HERE\.md$|\.github/workflows/opskit-[^/]+\.yml$)'
HEAD_BEFORE="$(git -C "$REPO" rev-parse HEAD)"
TMP="$(mktemp -d)"
WT="$TMP/wt"
cleanup() {
  git -C "$REPO" worktree remove --force "$WT" >/dev/null 2>&1 || true
  git -C "$REPO" worktree prune >/dev/null 2>&1 || true
  rm -rf "$TMP"
}
trap cleanup EXIT

echo "rehearsal: kit built on ${BASE}, moved onto ${OLD}, then merging ${NEW}"
# our kit = EVERY difference between BASE and HEAD: our paths plus any patched upstream files (ledger entries)
git -C "$REPO" diff --binary "$BASE" HEAD >"$TMP/kit.patch"
git -C "$REPO" worktree add -q --detach "$WT" "$OLD"
if [ -s "$TMP/kit.patch" ]; then
  if ! git -C "$WT" apply --index --binary "$TMP/kit.patch" 2>"$TMP/apply.err"; then
    echo "CONFLICTS: our kit does not apply onto ${OLD} (upstream changed the same lines between the releases):"
    sed 's/^/  /' "$TMP/apply.err" | head -n 10
    echo "(the real branch was not touched)"
    exit 1
  fi
fi
GIT=(git -C "$WT" -c user.name=rehearsal -c user.email=rehearsal@local -c commit.gpgsign=false)
"${GIT[@]}" commit -q --allow-empty -m "rehearsal: kit on ${OLD}"
if ! "${GIT[@]}" merge --no-edit -q "$NEW" >"$TMP/merge.log" 2>&1; then
  echo "CONFLICTS merging ${NEW}:"
  git -C "$WT" diff --name-only --diff-filter=U | sed 's/^/  - /'
  echo "(the real branch was not touched)"
  [ "$(git -C "$REPO" rev-parse HEAD)" = "$HEAD_BEFORE" ] || { echo "BUG: real HEAD moved" >&2; exit 2; }
  exit 1
fi
bad="$(git -C "$WT" diff --name-only "$NEW" HEAD | grep -Ev "$ALLOWED" || true)"
unlisted=""
for f in $bad; do
  grep -qF "$f" "$REPO/docs/UPSTREAM_CHANGES.md" 2>/dev/null || unlisted+="${f}"$'\n'
done
if [ -n "$unlisted" ]; then
  echo "FAIL: after the merge these upstream files differ from ${NEW} and are NOT in the patch ledger (docs/UPSTREAM_CHANGES.md):"
  printf '%s' "$unlisted" | sed 's/^/  - /'
  exit 1
fi
[ -z "$bad" ] || echo "note: ${NEW} merged with these ledger-listed upstream patches carried over: $(printf '%s' "$bad" | tr '\n' ' ')"
[ "$(git -C "$REPO" rev-parse HEAD)" = "$HEAD_BEFORE" ] || { echo "BUG: real HEAD moved" >&2; exit 2; }
echo "OK: ${NEW} merges cleanly into ${OLD} + our kit; only our paths differ from ${NEW}"
