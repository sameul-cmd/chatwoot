usage() {
  cat <<'EOF'
Usage: opskit <command> [args]

Commands:
  doctor                      check required tools
  client validate <file>      validate a client.yaml against the schema
  client new <id> --domain <d> [--name <n>] [--local]   create opskit/clients/<id>/client.yaml
  client render <id>          render compose/.env/Caddyfile into clients/<id>/stack (secrets generated once)
  client deploy <id>          build, db:chatwoot_prepare, start, wait healthy, create the Super Admin (local target)
  client check <id>           post-deploy checks (PASS/FAIL table)
  client pause|resume <id>    stop / start the stack
  client offboard <id> --yes  DESTRUCTIVE: delete containers + volumes (needs typed client id)
  backup run|list <id>        back up (db + uploads + encrypted secrets), prune, copy off-server / list backups
  backup verify <id> [--identity key] [--keep]   restore the latest backup into a throw-away staging stack and check it
  restore <id> --from <ts|latest> --target staging [--identity key] [--overwrite --yes]   restore into a fresh staging stack
  monitor run <id> [--channels] | status <id>   run the health checks (host: every 5 min; --channels: every 15 min) / show state
  alerts set-telegram|test <id>   save the Telegram bot settings (env TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID) / send a test message
  upgrade <id> --to <tag> --info|--stage|--apply [--yes] [--outage-fix]
                              safe upgrade: release info / rehearsal on a copy / live upgrade with automatic rollback
  host bootstrap <host> [--user U] [--dry-run]   prepare a fresh Ubuntu host (Docker, ufw, swap, updates)
  bot validate <file>         validate a bot.yaml against the schema
  pack validate <file>        validate a pack item file against the schema
  llm models|effort <client>  BYOK model picker / effort (available in Phase 8)
  selftest                    end-to-end local self test (available from Phase 2)
  help                        show this help
EOF
}

# Tools: name|hint
REQUIRED_TOOLS="bash|bash 4+ ;git|apt install git ;curl|apt install curl ;openssl|apt install openssl ;jq|apt install jq ;yq|install mikefarah yq ;envsubst|apt install gettext-base ;shellcheck|apt install shellcheck ;bats|apt install bats ;python3|apt install python3 ;docker|install Docker Engine/Desktop ;age|apt install age ;rclone|apt install rclone"

cmd_doctor() {
  local missing=0 entry name hint
  local IFS=';'
  for entry in $REQUIRED_TOOLS; do
    name="${entry%%|*}"
    hint="${entry#*|}"
    if command -v "$name" >/dev/null 2>&1; then
      printf 'ok       %s\n' "$name"
    else
      printf 'MISSING  %s  (%s)\n' "$name" "$hint"
      missing=1
    fi
  done
  IFS=$' \t\n'
  if python3 -c 'import jsonschema, yaml, referencing' >/dev/null 2>&1; then
    printf 'ok       python: jsonschema, pyyaml\n'
  else
    printf 'MISSING  python packages jsonschema, pyyaml  (pip install jsonschema pyyaml)\n'
    missing=1
  fi
  return "$missing"
}

# valid_client_id ID -> same pattern as the schema; checked before any path is built from the id.
valid_client_id() { [[ "${1:-}" =~ ^[a-z][a-z0-9-]{1,30}$ ]]; }

cmd_client_new() {
  local id="${1:-}" domain="" name="" target="remote" http_port="" https_port="" tag="v4.18.0-ce"
  [ -n "$id" ] || { log_error "usage: opskit client new <id> --domain <domain> [--name <name>] [--local [--http-port N --https-port N]]"; return 2; }
  valid_client_id "$id" || { log_error "invalid client id '$id' (lowercase letters, digits, dashes; 2-31 chars)"; return 2; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --domain) domain="${2:-}"; shift 2 ;;
      --name) name="${2:-}"; shift 2 ;;
      --local) target="local"; shift ;;
      --tag) tag="${2:-}"; shift 2 ;;
      --http-port) http_port="${2:-}"; shift 2 ;;
      --https-port) https_port="${2:-}"; shift 2 ;;
      *) log_error "unknown option: $1"; return 2 ;;
    esac
  done
  [ -n "$domain" ] || { log_error "--domain is required"; return 2; }
  [ -n "$name" ] || name="$id"
  local dir cfg
  dir="$(client_dir "$id")"
  cfg="$dir/client.yaml"
  [ ! -e "$cfg" ] || die "client '$id' already exists ($cfg)"
  mkdir -p "$dir"
  # shellcheck disable=SC2016  # envsubst variable list must stay literal
  CLIENT_ID="$id" CLIENT_NAME="$name" CLIENT_DOMAIN="$domain" CW_TAG="$tag" DEPLOY_TARGET="$target" \
    envsubst '${CLIENT_ID} ${CLIENT_NAME} ${CLIENT_DOMAIN} ${CW_TAG} ${DEPLOY_TARGET}' <"$OPSKIT_ROOT/templates/client.yaml.tmpl" >"$cfg"
  [ -z "$http_port" ] || printf '  http_port: %s\n' "$http_port" >>"$cfg"
  [ -z "$https_port" ] || printf '  https_port: %s\n' "$https_port" >>"$cfg"
  if python3 "$OPSKIT_ROOT/lib/schema_check.py" client "$cfg"; then
    log_info "created $cfg"
  else
    rm -rf "$dir"
    return 1
  fi
}

cmd_client_lifecycle() {
  local sub="$1" id="${2:-}" yes=""
  [ -n "$id" ] || { log_error "usage: opskit client ${sub} <id>"; return 2; }
  valid_client_id "$id" || { log_error "invalid client id '$id'"; return 2; }
  shift 2 || true
  [ "${1:-}" = "--yes" ] && yes="yes"
  [ -d "$(client_dir "$id")" ] || die "client not found: $id"
  case "$sub" in
    render) render_client "$id" ;;
    deploy) deploy_client "$id" ;;
    check) post_deploy_checks "$id" ;;
    pause) pause_client "$id" ;;
    resume) resume_client "$id" ;;
    offboard) offboard_client "$id" "$yes" ;;
  esac
}

cmd_host_bootstrap() {
  local host="${1:-}" user="root" dry=""
  [ -n "$host" ] || { log_error "usage: opskit host bootstrap <host> [--user U] [--dry-run]"; return 2; }
  [[ "$host" =~ ^[A-Za-z0-9.-]+$ ]] || { log_error "invalid host '$host'"; return 2; }
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --user) user="${2:-}"; shift 2 ;;
      --dry-run) dry="--dry-run"; shift ;;
      *) log_error "unknown option: $1"; return 2 ;;
    esac
  done
  [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] || { log_error "invalid ssh user '$user'"; return 2; }
  log_info "bootstrapping ${user}@${host} ${dry}"
  if [ "$user" = "root" ]; then
    ssh_run "$user" "$host" bash -s -- ${dry:+"$dry"} <"$OPSKIT_ROOT/agent/bootstrap.sh"
  else
    ssh_run "$user" "$host" sudo bash -s -- ${dry:+"$dry"} <"$OPSKIT_ROOT/agent/bootstrap.sh"
  fi
}

# _selftest_row NAME STATUS DETAIL
_selftest_row() { printf '%-34s %-5s %s\n' "$1" "$2" "$3"; }

# selftest: deploy a throwaway local client, run the post-deploy checks, then backup -> restore test -> overwrite
# protection on seeded data (conversation + image attachment). Always tears everything down.
cmd_selftest() {
  local tmp rc=0 id="selftest" key out detail sid
  require_tool docker "install Docker" || return 1
  require_tool age-keygen "apt install age" || return 1
  tmp="$(mktemp -d)"
  export OPSKIT_CLIENTS_DIR="$tmp"
  export OPSKIT_ALERT_DIR="$tmp/alerts"
  sid="${id}-staging"
  key="$tmp/selftest-owner.key"
  age-keygen -o "$key" >/dev/null 2>&1
  export OPSKIT_AGE_RECIPIENT
  OPSKIT_AGE_RECIPIENT="$(age-keygen -y "$key")"
  # shellcheck disable=SC2064  # expand $tmp/$id now on purpose
  trap "teardown_staging $sid >/dev/null 2>&1 || true; OPSKIT_CONFIRM_ID=$id offboard_client $id yes >/dev/null 2>&1 || true; rm -rf '$tmp'" EXIT
  cmd_client_new "$id" --domain chat.selftest.localhost --name "Selftest" --local --http-port 18080 --https-port 18443 || return 1
  # start == end means "no quiet hours" so the monitoring scenarios do not depend on the time of day
  printf 'alerts:\n  quiet_hours:\n    start: "00:00"\n    end: "00:00"\n' >>"$tmp/$id/client.yaml"
  deploy_client "$id" || rc=1
  if [ "$rc" -eq 0 ]; then
    post_deploy_checks "$id" || rc=1
    ensure_admin "$id" >/dev/null 2>&1 || rc=1
  fi
  if [ "$rc" -eq 0 ]; then
    if cw_use_stack "$id" && detail="$(cw_seed_demo 2>&1)"; then _selftest_row "seed conversation + attachment" PASS "$detail"; else _selftest_row "seed conversation + attachment" FAIL "${detail:-no output}"; rc=1; fi
  fi
  if [ "$rc" -eq 0 ]; then
    if backup_run "$id" >/dev/null 2>&1 && [ -n "$(latest_backup "$id")" ]; then _selftest_row "backup (db + uploads + escrow)" PASS "$(basename "$(latest_backup "$id")")"; else _selftest_row "backup (db + uploads + escrow)" FAIL "see: opskit backup run $id"; rc=1; fi
  fi
  if [ "$rc" -eq 0 ]; then
    local bdir f plain=0
    bdir="$(latest_backup "$id")"
    for f in "$bdir"/*.age; do
      head -c 40 "$f" | grep -q "age-encryption.org" || plain=1
    done
    if [ "$plain" -eq 0 ] && ! grep -rqa "PGDMP" "$bdir" && [ -z "$(find "$bdir" -name 'db.dump' -o -name 'storage.tar.gz')" ]; then
      _selftest_row "backup is encrypted (no plaintext)" PASS "db, uploads and secrets are age-encrypted"
    else
      _selftest_row "backup is encrypted (no plaintext)" FAIL "plaintext found in $(basename "$bdir")"; rc=1
    fi
  fi
  if [ "$rc" -eq 0 ]; then
    if out="$(backup_verify "$id" --identity "$key" --keep 2>&1)"; then _selftest_row "restore test (login/conv/attachment)" PASS "$(printf '%s' "$out" | tail -n1 | cut -c1-110)"; else _selftest_row "restore test (login/conv/attachment)" FAIL "$(printf '%s' "$out" | tail -n1 | cut -c1-110)"; rc=1; fi
  fi
  if [ "$rc" -eq 0 ]; then
    if restore_client "$id" --from latest --target staging >/dev/null 2>&1; then
      _selftest_row "overwrite protection" FAIL "an existing staging stack was overwritten without --overwrite --yes"; rc=1
    elif OPSKIT_CONFIRM_ID=wrong restore_client "$id" --from latest --target staging --overwrite --yes >/dev/null 2>&1; then
      _selftest_row "overwrite protection" FAIL "a wrong typed id was accepted"; rc=1
    else
      _selftest_row "overwrite protection" PASS "refused without flags and with a wrong typed id"
    fi
  fi
  if [ "$rc" -eq 0 ]; then
    teardown_staging "$sid" >/dev/null 2>&1 || true
    _selftest_monitoring "$id" "$tmp" || rc=1
  fi
  if [ "$rc" -eq 0 ]; then echo "SELFTEST PASSED"; else echo "SELFTEST FAILED"; fi
  return "$rc"
}

# selftest upgrade: deploy on the OLD release, seed data, rehearse on a copy, prove the automatic rollback with an
# injected failure, then do the real upgrade. Releases can be overridden: OPSKIT_SELFTEST_FROM / OPSKIT_SELFTEST_TO.
cmd_selftest_upgrade() {
  local tmp rc=0 id="selfup" from to key dir mig0 conv0 detail out v want_from want_to
  from="${OPSKIT_SELFTEST_FROM:-v4.17.1-ce}"
  to="${OPSKIT_SELFTEST_TO:-v4.18.0-ce}"
  require_tool docker "install Docker" || return 1
  require_tool age-keygen "apt install age" || return 1
  tmp="$(mktemp -d)"
  export OPSKIT_CLIENTS_DIR="$tmp" OPSKIT_ALERT_DIR="$tmp/alerts"
  key="$tmp/selftest-owner.key"
  age-keygen -o "$key" >/dev/null 2>&1
  export OPSKIT_AGE_RECIPIENT
  OPSKIT_AGE_RECIPIENT="$(age-keygen -y "$key")"
  dir="$tmp/$id"
  # shellcheck disable=SC2064
  trap "teardown_staging ${id}-staging >/dev/null 2>&1 || true; OPSKIT_CONFIRM_ID=$id offboard_client $id yes >/dev/null 2>&1 || true; rm -rf '$tmp'" EXIT
  cmd_client_new "$id" --domain chat.selfup.localhost --name "Selfup" --local --tag "$from" --http-port 19080 --https-port 19443 || return 1
  deploy_client "$id" || return 1
  want_from="${from%-ce}"
  want_from="${want_from#v}"
  want_to="${to%-ce}"
  want_to="${want_to#v}"
  if ! cw_use_stack "$id"; then _selftest_row "seed data on ${from}" FAIL "no API token"; return 1; fi
  if ! detail="$(cw_seed_demo 2>&1)"; then _selftest_row "seed data on ${from}" FAIL "${detail:-failed}"; return 1; fi
  mig0="$(_psql_sid "$id" 'SELECT count(*) FROM schema_migrations')"
  conv0="$(_psql_sid "$id" 'SELECT count(*) FROM conversations')"
  _selftest_row "deployed on ${from} with data" PASS "${conv0} conversation(s), ${mig0} migrations"

  if out="$(upgrade_stage "$id" "$to" 2>&1)"; then
    _selftest_row "staging rehearsal on ${to}" PASS "smoke tests passed on the copy; migrations applied: $(jq -r .migrations_applied "$dir/upgrade/staging-${to}.json")"
  else
    _selftest_row "staging rehearsal on ${to}" FAIL "$(printf '%s' "$out" | tail -n1 | cut -c1-120)"
    return 1
  fi

  OPSKIT_UPGRADE_FAIL_SMOKE=production OPSKIT_CONFIRM_ID="$id" upgrade_apply "$id" "$to" yes "" >/dev/null 2>&1 && rc=1
  v="$(curl -ks --resolve chat.selfup.localhost:19443:127.0.0.1 https://chat.selfup.localhost:19443/api | jq -r .version)"
  if [ "$rc" -eq 0 ] && [ "$(yq -r .install.tag "$dir/client.yaml")" = "$from" ] && [ "${v:-?}" = "$want_from" ] \
    && [ "$(_psql_sid "$id" 'SELECT count(*) FROM schema_migrations')" = "$mig0" ] && [ "$(_psql_sid "$id" 'SELECT count(*) FROM conversations')" = "$conv0" ]; then
    _selftest_row "injected failure -> automatic rollback" PASS "back on ${from}, database restored, ${conv0} conversation(s) intact"
  else
    _selftest_row "injected failure -> automatic rollback" FAIL "tag=$(yq -r .install.tag "$dir/client.yaml") version=${v:-?}"
    return 1
  fi

  if OPSKIT_CONFIRM_ID="$id" upgrade_apply "$id" "$to" yes "" >/dev/null 2>&1; then
    v="$(curl -ks --resolve chat.selfup.localhost:19443:127.0.0.1 https://chat.selfup.localhost:19443/api | jq -r .version)"
    if [ "$(yq -r .install.tag "$dir/client.yaml")" = "$to" ] && [ "${v:-?}" = "$want_to" ] \
      && [ "$(_psql_sid "$id" 'SELECT count(*) FROM conversations')" = "$conv0" ] && [ "$(_psql_sid "$id" 'SELECT count(*) FROM schema_migrations')" -gt "$mig0" ]; then
      _selftest_row "real upgrade to ${to}" PASS "version ${v}, migrations $(_psql_sid "$id" 'SELECT count(*) FROM schema_migrations') (was ${mig0}), data intact"
    else
      _selftest_row "real upgrade to ${to}" FAIL "state does not match after the upgrade"; rc=1
    fi
  else
    _selftest_row "real upgrade to ${to}" FAIL "upgrade command failed"; rc=1
  fi
  if [ "$(jq -r .result "$dir/upgrade/history.jsonl" | grep -c -E '^(success|rolled_back)$')" -ge 2 ]; then
    _selftest_row "upgrade history written" PASS "$(jq -r .result "$dir/upgrade/history.jsonl" | tr '\n' ' ')"
  else
    _selftest_row "upgrade history written" FAIL "history incomplete"; rc=1
  fi
  if [ "$rc" -eq 0 ]; then echo "SELFTEST UPGRADE PASSED"; else echo "SELFTEST UPGRADE FAILED"; fi
  return "$rc"
}

# _selftest_monitoring ID TMPDIR -> acceptance scenarios of SPEC Phase 4 against a pretend Telegram
_selftest_monitoring() {
  local id="$1" tmp="$2" fakepid real rc=0 st log portf port
  log="$tmp/tg.log"
  portf="$tmp/tg.port"
  : >"$log"
  python3 "$OPSKIT_ROOT/tests/fake_telegram.py" "$portf" "$log" &
  fakepid=$!
  # shellcheck disable=SC2064
  trap "kill $fakepid 2>/dev/null; teardown_staging ${id}-staging >/dev/null 2>&1 || true; OPSKIT_CONFIRM_ID=$id offboard_client $id yes >/dev/null 2>&1 || true; rm -rf '$tmp'" EXIT
  for _ in $(seq 1 50); do [ -s "$portf" ] && break; sleep 0.1; done
  port="$(cat "$portf")"
  export TELEGRAM_API_BASE="http://127.0.0.1:${port}"
  (umask 077 && printf 'TELEGRAM_BOT_TOKEN=123456:selftestSELFTESTselftestSELF\nTELEGRAM_CHAT_ID=1\n' >"$(alerts_env_file "$id")")
  real="$(date -u +%s)"
  n() { wc -l <"$log" | tr -d ' '; }
  tg() { jq -r .text "$log" | grep -q "$1"; }
  # sidekiq_alive ID -> waits until the worker registered again (max 90 s)
  sidekiq_back() {

    for _ in $(seq 1 30); do
      check_sidekiq "$id" | grep -q '|ok|' && return 0
      sleep 3
    done
    return 1
  }

  monitor_run "$id" >/dev/null 2>&1; monitor_run "$id" --channels >/dev/null 2>&1
  if [ "$(n)" = "0" ]; then _selftest_row "monitoring: healthy stack is silent" PASS "0 messages"; else _selftest_row "monitoring: healthy stack is silent" FAIL "$(n) unexpected messages"; rc=1; fi

  dc "$id" stop sidekiq >/dev/null 2>&1; sleep 3
  monitor_run "$id" >/dev/null 2>&1
  if tg "CRITICAL.*Sidekiq"; then _selftest_row "monitoring: Sidekiq stopped -> critical" PASS "Telegram message at the first check (<= 5 min)"; else _selftest_row "monitoring: Sidekiq stopped -> critical" FAIL "no critical message"; rc=1; fi
  st="$(n)"
  OPSKIT_STATE_NOW=$((real + 300)) monitor_run "$id" >/dev/null 2>&1
  if [ "$(n)" = "$st" ]; then _selftest_row "monitoring: no repeat within 30 min" PASS "same alert not re-sent"; else _selftest_row "monitoring: no repeat within 30 min" FAIL "repeated"; rc=1; fi
  dc "$id" start sidekiq >/dev/null 2>&1; sidekiq_back
  OPSKIT_STATE_NOW=$((real + 900)) monitor_run "$id" >/dev/null 2>&1
  if tg "RESOLVED.*Sidekiq"; then _selftest_row "monitoring: recovery -> resolved" PASS "one RESOLVED message"; else _selftest_row "monitoring: recovery -> resolved" FAIL "no resolved message"; rc=1; fi

  dc "$id" stop >/dev/null 2>&1; sleep 3
  OPSKIT_STATE_NOW=$((real + 3000)) monitor_run "$id" >/dev/null 2>&1
  if tg "CRITICAL.*Website" && tg "CRITICAL.*Services"; then _selftest_row "monitoring: whole stack stopped -> uptime alert" PASS "Website + Services critical"; else _selftest_row "monitoring: whole stack stopped -> uptime alert" FAIL "missing critical messages"; rc=1; fi
  dc "$id" start >/dev/null 2>&1; wait_healthy "$id" 240 >/dev/null 2>&1; sidekiq_back
  OPSKIT_STATE_NOW=$((real + 3300)) monitor_run "$id" >/dev/null 2>&1

  dc "$id" exec -T -e ACTION=break rails bundle exec rails runner - <"$OPSKIT_ROOT/tests/rails/sim_inbox.rb" >/dev/null 2>&1
  OPSKIT_STATE_NOW=$((real + 3600)) monitor_run "$id" --channels >/dev/null 2>&1
  if tg "re-connected"; then _selftest_row "monitoring: disconnected inbox reported" PASS "critical for the simulated inbox"; else _selftest_row "monitoring: disconnected inbox reported" FAIL "not reported"; rc=1; fi
  dc "$id" exec -T -e ACTION=fix rails bundle exec rails runner - <"$OPSKIT_ROOT/tests/rails/sim_inbox.rb" >/dev/null 2>&1
  OPSKIT_STATE_NOW=$((real + 4500)) monitor_run "$id" --channels >/dev/null 2>&1
  if tg "RESOLVED.*Channel"; then _selftest_row "monitoring: inbox fixed -> resolved" PASS "RESOLVED message"; else _selftest_row "monitoring: inbox fixed -> resolved" FAIL "no resolved message"; rc=1; fi

  dc "$id" stop sidekiq >/dev/null 2>&1; sleep 3
  st="$(n)"
  if TELEGRAM_API_BASE="http://127.0.0.1:9" OPSKIT_STATE_NOW=$((real + 7000)) monitor_run "$id" >/dev/null 2>&1; then
    _selftest_row "monitoring: Telegram unreachable" FAIL "no error exit"; rc=1
  elif [ "$(n)" = "$st" ] && [ -n "$(ls "$OPSKIT_ALERT_DIR" 2>/dev/null)" ]; then
    OPSKIT_STATE_NOW=$((real + 7300)) monitor_run "$id" >/dev/null 2>&1
    if [ "$(n)" -gt "$st" ]; then _selftest_row "monitoring: Telegram unreachable" PASS "kept in outbox, delivered next cycle"; else _selftest_row "monitoring: Telegram unreachable" FAIL "not delivered later"; rc=1; fi
  else
    _selftest_row "monitoring: Telegram unreachable" FAIL "alert lost"; rc=1
  fi
  dc "$id" start sidekiq >/dev/null 2>&1
  kill "$fakepid" 2>/dev/null || true
  return "$rc"
}

cmd_validate() {
  local kind="$1" file="${2:-}"
  [ -n "$file" ] || {
    log_error "usage: opskit ${kind} validate <file>"
    return 2
  }
  [ -f "$file" ] || die "file not found: $file"
  if python3 "$OPSKIT_ROOT/lib/schema_check.py" "$kind" "$file"; then
    echo "valid: $file"
  else
    return 1
  fi
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help | -h | --help) usage ;;
    doctor) cmd_doctor ;;
    client | bot | pack)
      local sub="${1:-}"
      shift || true
      case "$sub" in
        validate) cmd_validate "$cmd" "$@" ;;
        new | render | deploy | check | pause | resume | offboard)
          if [ "$cmd" != "client" ]; then
            usage >&2
            exit 2
          elif [ "$sub" = "new" ]; then
            cmd_client_new "$@"
          else
            cmd_client_lifecycle "$sub" "$@"
          fi
          ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    upgrade)
      local uid="${1:-}" uto="" umode="" uyes="" uout=""
      valid_client_id "$uid" || { log_error "usage: opskit upgrade <id> --to <tag> --info|--stage|--apply [--yes] [--outage-fix]"; exit 2; }
      [ -d "$(client_dir "$uid")" ] || die "client not found: $uid"
      shift
      while [ $# -gt 0 ]; do
        case "$1" in
          --to) uto="${2:-}"; shift 2 ;;
          --info) umode="info"; shift ;;
          --stage) umode="stage"; shift ;;
          --apply) umode="apply"; shift ;;
          --yes) uyes="yes"; shift ;;
          --outage-fix) uout="yes"; shift ;;
          *) log_error "unknown option: $1"; exit 2 ;;
        esac
      done
      _tag_valid "$uto" || { log_error "--to must be a Community Edition tag like v4.18.0-ce"; exit 2; }
      _require_local "$uid"
      case "$umode" in
        info) upgrade_info "$uid" "$uto" ;;
        stage) upgrade_stage "$uid" "$uto" ;;
        apply) upgrade_apply "$uid" "$uto" "$uyes" "$uout" ;;
        *)
          log_error "choose one of --info, --stage, --apply"
          exit 2
          ;;
      esac
      ;;
    monitor)
      local msub="${1:-}" mid="${2:-}"
      valid_client_id "$mid" || { log_error "usage: opskit monitor run|status <id>"; exit 2; }
      [ -d "$(client_dir "$mid")" ] || die "client not found: $mid"
      case "$msub" in
        run)
          shift 2
          monitor_run "$mid" "$@"
          ;;
        status) monitor_status "$mid" ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    alerts)
      local asub="${1:-}" aid="${2:-}"
      valid_client_id "$aid" || { log_error "usage: opskit alerts set-telegram|test <id>"; exit 2; }
      [ -d "$(client_dir "$aid")" ] || die "client not found: $aid"
      case "$asub" in
        set-telegram) alerts_set_telegram "$aid" ;;
        test) telegram_send "$(alerts_env_file "$aid")" "✅ Test message from opskit for client ${aid}" && echo "test message sent" ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    restore)
      local rid="${1:-}"
      valid_client_id "$rid" || { log_error "usage: opskit restore <id> --from <ts|latest> --target staging"; exit 2; }
      [ -d "$(client_dir "$rid")" ] || die "client not found: $rid"
      shift
      restore_client "$rid" "$@"
      ;;
    backup)
      local bsub="${1:-}" bid="${2:-}"
      valid_client_id "$bid" || { log_error "usage: opskit backup run|list <id>"; exit 2; }
      [ -d "$(client_dir "$bid")" ] || die "client not found: $bid"
      case "$bsub" in
        run) backup_run "$bid" ;;
        list) backup_list "$bid" ;;
        verify)
          shift 2
          backup_verify "$bid" "$@"
          ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    host)
      case "${1:-}" in
        bootstrap)
          shift
          cmd_host_bootstrap "$@"
          ;;
        *)
          usage >&2
          exit 2
          ;;
      esac
      ;;
    llm)
      echo "opskit llm: available in Phase 8 (BYOK model picker, ADR-011)" >&2
      exit 3
      ;;
    selftest)
      if [ "${1:-}" = "upgrade" ]; then cmd_selftest_upgrade; else cmd_selftest; fi
      ;;
    *)
      usage >&2
      exit 2
      ;;
  esac
}

main "$@"
