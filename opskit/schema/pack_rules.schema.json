{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/pack_rules.schema.json",
  "title": "Pack keyword rules (a customer message with a keyword gets a label)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "industry",
    "items"
  ],
  "properties": {
    "industry": {
      "enum": [
        "generic",
        "fcommerce",
        "clinic",
        "travel",
        "education",
        "service"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "label",
          "keywords"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 40
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "label": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$"
          },
          "keywords": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "bn"
            ],
            "properties": {
              "en": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                }
              },
              "bn": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 40
                }
              }
            }
          },
          "review_required": {
            "type": "boolean",
            "default": true,
            "description": "Bangla text stays true until the owner (native speaker) approves it."
          }
        }
      }
    }
  }
}
