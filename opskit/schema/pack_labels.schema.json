{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/pack_labels.schema.json",
  "title": "Pack labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "industry",
    "items"
  ],
  "properties": {
    "industry": {
      "enum": [
        "generic",
        "fcommerce",
        "clinic",
        "travel",
        "education",
        "service"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "color",
          "description"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+$",
            "maxLength": 40
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    }
  }
}
