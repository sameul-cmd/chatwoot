{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opskit.local/schema/client.schema.json",
  "title": "Client registry entry (client.yaml), SPEC section 6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "client_id",
    "name",
    "timezone",
    "languages",
    "domain",
    "install",
    "accounts"
  ],
  "properties": {
    "client_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,30}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "contact": {
      "type": "object"
    },
    "timezone": {
      "type": "string",
      "pattern": "^[A-Za-z_]+/[A-Za-z_/+-]+$|^UTC$"
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bn",
          "en"
        ]
      }
    },
    "domain": {
      "type": "string",
      "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?\\.)+[a-z]{2,}$"
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "ip": {
          "type": "string"
        },
        "ssh_user": {
          "type": "string"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "dedicated"
          ]
        },
        "image": {
          "type": "string"
        },
        "tag": {
          "type": "string",
          "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+(-ce.*)?$"
        }
      }
    },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "account_id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "sizing": {
      "type": "object"
    },
    "smtp": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "user": {
          "type": "string"
        },
        "sender": {
          "type": "string"
        }
      }
    },
    "storage": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "local",
            "s3"
          ]
        }
      }
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "name"
        ]
      }
    },
    "pack": {
      "type": "string"
    },
    "bot": {
      "$ref": "https://opskit.local/schema/bot.schema.json"
    },
    "alerts": {
      "type": "object"
    },
    "support": {
      "type": "object"
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_dir": {
          "type": "string",
          "minLength": 1
        },
        "schedule": {
          "type": "string",
          "pattern": "^([0-9*/,-]+ ){4}[0-9*/,A-Za-z-]+$",
          "default": "0 2 * * *"
        },
        "retention_local": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365,
          "default": 14
        },
        "retention_remote": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3650,
          "default": 30
        },
        "remote": {
          "type": "string",
          "minLength": 1,
          "description": "rclone destination (name:path or an absolute folder)"
        }
      }
    },
    "report": {
      "type": "object"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "offboarded"
      ]
    },
    "addons": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reserved for V2 add-ons (docs/ADDONS.md). All must stay disabled until built.",
      "properties": {
        "order_capture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "order_status": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "auto_labels": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "after_hours_csat": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "owner_digest": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "agent_assist": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "kb_editor": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        },
        "booking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "const": false,
              "default": false
            },
            "settings": {
              "type": "object"
            }
          }
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "description": "Reserved white-label block (owner decision pending, docs/ADDONS.md section 1). Default: Chatwoot branding.",
      "properties": {
        "mode": {
          "enum": [
            "chatwoot"
          ],
          "default": "chatwoot"
        },
        "name": {
          "type": "string"
        },
        "logo": {
          "type": "string"
        },
        "logo_dark": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      }
    },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "enum": [
            "local",
            "remote"
          ],
          "default": "remote"
        },
        "http_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "https_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
